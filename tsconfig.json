{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "bundler", "allowImportingTsExtensions": true, "jsx": "react-jsx",
    "strict": true, "noEmit": true, "skipLibCheck": true, "types": ["vite/client"]
  },
  "include": ["src/**/*.tsx", "src/model.ts", "src/engine.ts", "src/storage.ts"]
}
